# ==========================================
# ExaSettle Environment Configuration
# Track 01 - Money, Risk & Regulation
# ==========================================
# DO NOT put real secrets in this file. Copy to .env and configure privately.

# Exasol Personal Analytical Database Configuration
EXASOL_HOST=localhost
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=change_me
EXASOL_SCHEMA=EXA_SETTLE
EXASOL_ENCRYPTION=True

# Application Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=False
APP_SECRET_KEY=exasettle_dev_secret_key

# MiroFish & Model API Configuration
# MiroFish uses OpenAI SDK format for LLM calls and Zep Cloud for agent memory graph
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=

# MiroFish Service Configuration
MIROFISH_SERVICE_URL=http://localhost:5000
